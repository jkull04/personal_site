{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jameskull-studio-storage",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "studio-api.jameskull.com",
      "custom_domain": true
    },
    {
      "pattern": "images.jameskull.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://www.jameskull.com,https://jameskull.com",
    "PAUSED": "false"
  },
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "jameskull-photos"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BUDGET",
        "class_name": "StorageBudget"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "StorageBudget"
      ]
    }
  ]
}
