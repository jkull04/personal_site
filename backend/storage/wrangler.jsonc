{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jameskull-studio-storage",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://www.jameskull.com,https://jameskull.com",
    "PAUSED": "false",
    "AUTH_VERSION": "2",
    "REQUIRE_CHECKS": "true"
  },
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "jameskull-photos"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "READ_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BUDGET",
        "class_name": "StorageBudget"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "StorageBudget"
      ]
    }
  ],
  "account_id": "a9e6f5645954b0f0396a99486a0a47d2"
}
